<?xml version="1.0" encoding="utf-8"?>
<!--
    ViewCash splash for portrait layouts.
    Pure orange fill — shown as window background before splash drawable renders.
    This eliminates the white frame on older/slower devices.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF8008" />
</shape>
