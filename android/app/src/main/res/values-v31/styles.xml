<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) splash screen configuration.
    On Android 12+, the OS enforces a native SplashScreen API.
    These attributes override the base styles.xml for API 31+.
-->
<resources>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- The full-screen background color of the splash screen -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>

        <!-- App icon displayed in the center circle on the splash -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>

        <!-- The icon background color (the circle behind the icon) -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>

        <!-- Duration of the splash animation in ms (0 = instant dismiss) -->
        <item name="windowSplashScreenAnimationDuration">0</item>

        <!-- Theme to switch to AFTER splash is dismissed -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
